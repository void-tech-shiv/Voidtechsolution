{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidtechsolution",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "voidtechsolution"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "IS_CLOUDFLARE_WORKER": "true",
    "NODE_ENV": "production"
  },
  "keep_vars": true
}
