{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voidtech-solution",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "IS_CLOUDFLARE_WORKER": "true"
  }
}
