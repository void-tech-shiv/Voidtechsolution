// ==============================================================================
// VOIDTECH SOLUTION — Prisma Schema
// Provider: PostgreSQL
// Phase: Phase 3 (Database Architecture & Data Layer)
// Brand Tagline: Build. Launch. Grow Online.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// 1. INBOUND CLIENT ENQUIRIES
// ------------------------------------------------------------------------------
enum EnquiryStatus {
  NEW
  IN_REVIEW
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum ServiceCategory {
  WEB_DEVELOPMENT
  MOBILE_DEVELOPMENT
  API_BACKEND
  AI_AUTOMATION
  BOTS_AUTOMATION
  DESIGN_CREATIVE
  ENTERPRISE_SYSTEMS
  FINTECH_PAYMENTS
  CLOUD_HOSTING
  OTHER
}

model Enquiry {
  id              String          @id @default(cuid())
  name            String
  email           String
  phone           String?
  companyName     String?
  serviceCategory ServiceCategory @default(WEB_DEVELOPMENT)
  budgetRange     String?
  timeline        String?
  message         String          @db.Text
  selectedPackage String?
  additionalConfig Json?
  referenceUrl    String?
  consentGiven    Boolean?
  status          EnquiryStatus   @default(NEW)
  internalNotes   String?         @db.Text
  ipHash          String?
  userAgent       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("enquiries")
}

// ------------------------------------------------------------------------------
// 2. AGENCY SERVICE CATALOG (18 Offerings)
// ------------------------------------------------------------------------------
model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDesc        String
  fullDesc         String          @db.Text
  icon             String          @default("Code")
  category         ServiceCategory
  deliverables     String[]
  technologies     String[]
  startingPriceInr Int?
  currency         String          @default("INR")
  isFeatured       Boolean         @default(false)
  isActive         Boolean         @default(true)
  orderIndex       Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([category])
  @@index([isActive, orderIndex])
  @@map("services")
}

// ------------------------------------------------------------------------------
// 3. PORTFOLIO & CASE STUDIES (DEMO / CONCEPT LAB BENCHMARKS)
// ------------------------------------------------------------------------------
model PortfolioProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  clientName  String
  industry    String
  summary     String
  challenge   String   @db.Text
  solution    String   @db.Text
  results     String   @db.Text
  techStack   String[]
  metrics     Json?    // e.g. [{"label": "Simulated Latency", "value": "< 2ms"}, {"label": "Benchmark Uptime", "value": "99.99%"}]
  heroImage   String?
  liveUrl     String?
  githubUrl   String?
  projectType String   @default("CONCEPT") // "CONCEPT" | "INTERNAL_PROTOTYPE" | "PRODUCTION"
  isFeatured  Boolean  @default(false)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isFeatured, orderIndex])
  @@index([projectType])
  @@map("portfolio_projects")
}

// ------------------------------------------------------------------------------
// 4. ADMIN USERS & ACCESS CONTROL
// ------------------------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ------------------------------------------------------------------------------
// 5. PRICING PACKAGES (INR PRICING TIERS)
// ------------------------------------------------------------------------------
model PricingPackage {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  category        ServiceCategory @default(WEB_DEVELOPMENT)
  priceInr        Int
  currency        String          @default("INR")
  isStartingPrice Boolean         @default(true)
  billingPeriod   String?         // "one-time" | "starting" | "monthly"
  features        String[]
  popular         Boolean         @default(false)
  orderIndex      Int             @default(0)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([isActive, orderIndex])
  @@index([category])
  @@map("pricing_packages")
}

// ------------------------------------------------------------------------------
// 6. FREQUENTLY ASKED QUESTIONS (FAQ)
// ------------------------------------------------------------------------------
model FAQ {
  id         String   @id @default(cuid())
  question   String
  answer     String   @db.Text
  category   String   @default("GENERAL")
  orderIndex Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([isActive, orderIndex])
  @@map("faqs")
}

// ------------------------------------------------------------------------------
// 7. SITE SETTINGS & CONFIGURATION
// ------------------------------------------------------------------------------
model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

// ------------------------------------------------------------------------------
// 8. AUDIT LOGS
// ------------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. "USER_LOGIN", "ENQUIRY_STATUS_UPDATE", "SETTINGS_CHANGE", "PASSWORD_RESET"
  entity     String   // e.g. "AdminUser", "Enquiry", "SiteSetting", "PricingPackage"
  entityId   String?
  actorId    String?
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 9. OTP VERIFICATIONS
// ------------------------------------------------------------------------------
enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  ENQUIRY_VERIFICATION
  ADMIN_ACTION
}

model OtpVerification {
  id                String     @id @default(cuid())
  identifier        String     // e.g. Email or phone number
  codeHash          String     // Cryptographic SHA-256 hash of OTP code + salt
  purpose           OtpPurpose @default(LOGIN)
  expiresAt         DateTime
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  resendAvailableAt DateTime
  isUsed            Boolean    @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([identifier, purpose])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("otp_verifications")
}

// ------------------------------------------------------------------------------
// 10. EMAIL DELIVERY TRACKING
// ------------------------------------------------------------------------------
enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model EmailDelivery {
  id                String              @id @default(cuid())
  recipient         String
  subject           String
  template          String              // e.g. "OTP_VERIFICATION", "PASSWORD_RESET", "ENQUIRY_CONFIRMATION"
  status            EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  failureCode       String?
  errorMessage      String?             @db.Text
  retryCount        Int                 @default(0)
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([recipient])
  @@index([status])
  @@index([template])
  @@index([createdAt])
  @@map("email_deliveries")
}
