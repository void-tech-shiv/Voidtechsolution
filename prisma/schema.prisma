// ==============================================================================
// VOIDTECH SOLUTION — Prisma Schema
// Provider: PostgreSQL
// Phase: Phase 3 (Database Architecture & Data Layer)
// Brand Tagline: Build. Launch. Grow Online.
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// 1. INBOUND CLIENT ENQUIRIES & CRM LEAD PIPELINE
// ------------------------------------------------------------------------------
enum EnquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum ServiceCategory {
  WEB_DEVELOPMENT
  MOBILE_DEVELOPMENT
  API_BACKEND
  AI_AUTOMATION
  BOTS_AUTOMATION
  DESIGN_CREATIVE
  ENTERPRISE_SYSTEMS
  FINTECH_PAYMENTS
  CLOUD_HOSTING
  OTHER
}

model Enquiry {
  id               String          @id @default(cuid())
  name             String
  email            String
  phone            String?
  companyName      String?
  serviceCategory  ServiceCategory @default(WEB_DEVELOPMENT)
  budgetRange      String?
  timeline         String?
  message          String          @db.Text
  selectedPackage  String?
  additionalConfig Json?
  referenceUrl     String?
  consentGiven     Boolean?
  status           EnquiryStatus   @default(NEW)
  internalNotes    String?         @db.Text // Legacy note string preserved for backwards compatibility

  // CRM Extensions (Phase 9)
  assignedAdminId   String?
  assignedAdmin     AdminUser? @relation("AdminAssignedLeads", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  estimatedValueInr Int? // Confirmed commercial project value in INR
  source            String     @default("WEBSITE_CONTACT_FORM")
  lastContactedAt   DateTime?
  nextFollowUpAt    DateTime?
  lostReason        String? // Documented rationale when lead enters LOST status

  // CRM Relational Collections
  notes         LeadNote[]
  followUps     LeadFollowUp[]
  activities    LeadActivity[]
  assignments   LeadAssignment[]
  notifications AdminNotification[]

  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([status, createdAt(sort: Desc)])
  @@index([assignedAdminId, status])
  @@index([nextFollowUpAt])
  @@index([email])
  @@index([createdAt])
  @@map("enquiries")
}

// ------------------------------------------------------------------------------
// 2. AGENCY SERVICE CATALOG (18 Offerings)
// ------------------------------------------------------------------------------
model Service {
  id               String          @id @default(cuid())
  slug             String          @unique
  title            String
  shortDesc        String
  fullDesc         String          @db.Text
  icon             String          @default("Code")
  category         ServiceCategory
  deliverables     String[]
  technologies     String[]
  startingPriceInr Int?
  currency         String          @default("INR")
  isFeatured       Boolean         @default(false)
  isActive         Boolean         @default(true)
  orderIndex       Int             @default(0)

  // CMS Integration (Phase 10)
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive, orderIndex])
  @@map("services")
}

// ------------------------------------------------------------------------------
// 3. PORTFOLIO & CASE STUDIES (DEMO / CONCEPT LAB BENCHMARKS)
// ------------------------------------------------------------------------------
model PortfolioProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  clientName  String
  industry    String
  summary     String
  challenge   String   @db.Text
  solution    String   @db.Text
  results     String   @db.Text
  techStack   String[]
  metrics     Json? // e.g. [{"label": "Simulated Latency", "value": "< 2ms"}, {"label": "Benchmark Uptime", "value": "99.99%"}]
  heroImage   String?
  liveUrl     String?
  githubUrl   String?
  projectType String   @default("CONCEPT") // "CONCEPT" | "INTERNAL_PROTOTYPE" | "PRODUCTION"
  isFeatured  Boolean  @default(false)
  orderIndex  Int      @default(0)

  // CMS Integration (Phase 10)
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFeatured, orderIndex])
  @@index([projectType])
  @@map("portfolio_projects")
}

// ------------------------------------------------------------------------------
// 4. ADMIN USERS & ACCESS CONTROL
// ------------------------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id              String              @id @default(cuid())
  email           String              @unique
  passwordHash    String
  name            String
  role            UserRole            @default(ADMIN)
  isActive        Boolean             @default(true)
  lastLoginAt     DateTime?
  sessions        AdminSession[]
  assignedLeads   Enquiry[]           @relation("AdminAssignedLeads")
  leadNotes       LeadNote[]          @relation("AuthorNotes")
  leadFollowUps   LeadFollowUp[]      @relation("AssignedFollowUps")
  leadAssignments LeadAssignment[]    @relation("AdminAssignments")
  notifications   AdminNotification[] @relation("RecipientNotifications")

  // CMS Relations (Phase 10)
  publishedContentItems ContentItem[]     @relation("ContentItemPublisher")
  authoredRevisions     ContentRevision[] @relation("RevisionAuthor")
  verifiedTestimonials  Testimonial[]     @relation("TestimonialVerifier")
  uploadedMedia         MediaAsset[]      @relation("MediaUploader")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

model AdminSession {
  id           String    @id @default(cuid())
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String    @unique // SHA-256 hash of the opaque client cookie token
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ------------------------------------------------------------------------------
// 5. PRICING PACKAGES (INR PRICING TIERS)
// ------------------------------------------------------------------------------
model PricingPackage {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  category        ServiceCategory @default(WEB_DEVELOPMENT)
  priceInr        Int
  currency        String          @default("INR")
  isStartingPrice Boolean         @default(true)
  billingPeriod   String? // "one-time" | "starting" | "monthly"
  features        String[]
  popular         Boolean         @default(false)
  orderIndex      Int             @default(0)
  isActive        Boolean         @default(true)

  // CMS Integration (Phase 10)
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, orderIndex])
  @@index([category])
  @@map("pricing_packages")
}

// ------------------------------------------------------------------------------
// 6. FREQUENTLY ASKED QUESTIONS (FAQ)
// ------------------------------------------------------------------------------
model FAQ {
  id         String  @id @default(cuid())
  question   String
  answer     String  @db.Text
  category   String  @default("GENERAL")
  orderIndex Int     @default(0)
  isActive   Boolean @default(true)

  // CMS Integration (Phase 10)
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive, orderIndex])
  @@map("faqs")
}

// ------------------------------------------------------------------------------
// 7. SITE SETTINGS & CONFIGURATION
// ------------------------------------------------------------------------------
model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("site_settings")
}

// ------------------------------------------------------------------------------
// 8. AUDIT LOGS
// ------------------------------------------------------------------------------
model AuditLog {
  id         String   @id @default(cuid())
  action     String // e.g. "USER_LOGIN", "ENQUIRY_STATUS_UPDATE", "SETTINGS_CHANGE", "PASSWORD_RESET"
  entity     String // e.g. "AdminUser", "Enquiry", "SiteSetting", "PricingPackage"
  entityId   String?
  actorId    String?
  actorEmail String?
  ipAddress  String?
  userAgent  String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 9. OTP VERIFICATIONS
// ------------------------------------------------------------------------------
enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  ENQUIRY_VERIFICATION
  ADMIN_ACTION
}

model OtpVerification {
  id                String     @id @default(cuid())
  identifier        String // e.g. Email or phone number
  codeHash          String // Cryptographic SHA-256 hash of OTP code + salt
  purpose           OtpPurpose @default(LOGIN)
  expiresAt         DateTime
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  resendAvailableAt DateTime
  isUsed            Boolean    @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([identifier, purpose])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("otp_verifications")
}

// ------------------------------------------------------------------------------
// 10. EMAIL DELIVERY TRACKING
// ------------------------------------------------------------------------------
enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model EmailDelivery {
  id                String              @id @default(cuid())
  recipient         String
  subject           String
  template          String // e.g. "OTP_VERIFICATION", "PASSWORD_RESET", "ENQUIRY_CONFIRMATION"
  status            EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  failureCode       String?
  errorMessage      String?             @db.Text
  retryCount        Int                 @default(0)
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([recipient])
  @@index([status])
  @@index([template])
  @@index([createdAt])
  @@map("email_deliveries")
}

// ------------------------------------------------------------------------------
// 11. CRM LEAD MANAGEMENT & PIPELINE (Phase 9)
// ------------------------------------------------------------------------------

model LeadNote {
  id         String     @id @default(cuid())
  enquiryId  String
  enquiry    Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  authorId   String?
  author     AdminUser? @relation("AuthorNotes", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  content    String     @db.Text
  isPinned   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([enquiryId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("lead_notes")
}

model LeadFollowUp {
  id            String     @id @default(cuid())
  enquiryId     String
  enquiry       Enquiry    @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  assignedToId  String?
  assignedTo    AdminUser? @relation("AssignedFollowUps", fields: [assignedToId], references: [id], onDelete: SetNull)
  title         String
  description   String?    @db.Text
  dueAt         DateTime
  priority      String     @default("MEDIUM") // "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  isCompleted   Boolean    @default(false)
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([enquiryId])
  @@index([assignedToId, isCompleted])
  @@index([dueAt, isCompleted])
  @@map("lead_follow_ups")
}

model LeadActivity {
  id          String   @id @default(cuid())
  enquiryId   String
  enquiry     Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type        String // "STATUS_CHANGE" | "ASSIGNMENT" | "NOTE_ADDED" | "FOLLOWUP_CREATED" | "FOLLOWUP_COMPLETED"
  description String
  actorId     String?
  actorName   String?
  metadata    Json? // e.g. { from: "NEW", to: "QUALIFIED" }
  createdAt   DateTime @default(now())

  @@index([enquiryId, createdAt(sort: Desc)])
  @@index([type])
  @@map("lead_activities")
}

model LeadAssignment {
  id             String    @id @default(cuid())
  enquiryId      String
  enquiry        Enquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  adminId        String
  admin          AdminUser @relation("AdminAssignments", fields: [adminId], references: [id], onDelete: Cascade)
  assignedById   String?
  assignedByName String?
  assignedAt     DateTime  @default(now())
  unassignedAt   DateTime?
  isActive       Boolean   @default(true)
  notes          String?

  @@index([enquiryId, isActive])
  @@index([adminId, isActive])
  @@map("lead_assignments")
}

model AdminNotification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   AdminUser @relation("RecipientNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  enquiryId   String?
  enquiry     Enquiry?  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  type        String // "NEW_LEAD" | "LEAD_ASSIGNED" | "STATUS_CHANGED" | "FOLLOWUP_DUE" | "LEAD_WON"
  title       String
  message     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, isRead, createdAt(sort: Desc)])
  @@index([enquiryId])
  @@map("admin_notifications")
}

// ------------------------------------------------------------------------------
// 12. CMS HEADLESS CONTENT ENGINE & VERSIONING (Phase 10)
// ------------------------------------------------------------------------------

enum ContentType {
  SERVICE
  PRICING_PACKAGE
  PORTFOLIO_PROJECT
  FAQ
  PAGE_SECTION
  TESTIMONIAL
}

enum ContentPublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum RevisionLifecycleStatus {
  WORKING_DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED_SNAPSHOT
  SUPERSEDED
  REJECTED
}

enum TestimonialVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

enum ClientConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum StorageProviderType {
  LOCAL
  R2
}

model ContentItem {
  id                         String                   @id @default(cuid())
  slug                       String                   @unique
  contentType                ContentType
  version                    Int                      @default(1)
  publicationStatus          ContentPublicationStatus @default(DRAFT)
  currentPublishedRevisionId String?                  @unique
  currentWorkingRevisionId   String?                  @unique
  publishedAt                DateTime?
  publishedById              String?
  publisher                  AdminUser?               @relation("ContentItemPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  // Dual Revision Pointers (Safeguard 1)
  currentPublishedRevision ContentRevision? @relation("PublishedRevision", fields: [currentPublishedRevisionId], references: [id], onDelete: SetNull)
  currentWorkingRevision   ContentRevision? @relation("WorkingRevision", fields: [currentWorkingRevisionId], references: [id], onDelete: SetNull)

  // Append-Only Revision History
  revisions ContentRevision[] @relation("ContentItemRevisions")

  // Materialized 1-to-1 Domain Snapshots (Approach C)
  service          Service?
  pricingPackage   PricingPackage?
  portfolioProject PortfolioProject?
  faq              FAQ?
  pageSection      PageSection?
  testimonial      Testimonial?

  @@index([contentType, publicationStatus])
  @@index([slug])
  @@map("content_items")
}

model ContentRevision {
  id                  String                  @id @default(cuid())
  contentItemId       String
  contentItem         ContentItem             @relation("ContentItemRevisions", fields: [contentItemId], references: [id], onDelete: Restrict)
  versionNumber       Int
  revisionStatus      RevisionLifecycleStatus @default(WORKING_DRAFT)
  isPublishedSnapshot Boolean                 @default(false)
  title               String
  snapshotData        Json
  authorId            String?
  author              AdminUser?              @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName          String
  changeSummary       String?
  rejectionNote       String?
  createdAt           DateTime                @default(now())

  // Inverse Relations for ContentItem Dual Pointers
  publishedInContentItem ContentItem? @relation("PublishedRevision")
  workingInContentItem   ContentItem? @relation("WorkingRevision")

  @@unique([contentItemId, versionNumber])
  @@index([contentItemId, revisionStatus])
  @@index([contentItemId, isPublishedSnapshot])
  @@index([authorId])
  @@map("content_revisions")
}

model PageSection {
  id            String       @id @default(cuid())
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  key           String       @unique
  pageSlug      String
  title         String
  subtitle      String?
  content       String       @db.Text
  metadata      Json?
  mediaUrl      String?
  isActive      Boolean      @default(true)
  orderIndex    Int          @default(0)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([pageSlug, isActive, orderIndex])
  @@map("page_sections")
}

model Testimonial {
  id                      String                        @id @default(cuid())
  contentItemId           String?                       @unique
  contentItem             ContentItem?                  @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  clientName              String
  clientRole              String
  clientCompany           String
  content                 String                        @db.Text
  rating                  Int                           @default(5)
  avatarUrl               String?
  projectSlug             String?
  verificationStatus      TestimonialVerificationStatus @default(UNVERIFIED)
  verifiedById            String?
  verifiedBy              AdminUser?                    @relation("TestimonialVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt              DateTime?
  clientConsentStatus     ClientConsentStatus           @default(PENDING)
  clientConsentRecordedAt DateTime?
  consentEvidenceUrl      String?                       @db.Text
  orderIndex              Int                           @default(0)
  isActive                Boolean                       @default(true)
  publishedAt             DateTime?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  @@index([verificationStatus, clientConsentStatus, isActive])
  @@index([orderIndex])
  @@map("testimonials")
}

model MediaAsset {
  id             String              @id @default(cuid())
  storageKey     String              @unique
  provider       StorageProviderType @default(LOCAL)
  filename       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  sha256Hash     String
  isSvg          Boolean             @default(false)
  publicUrl      String
  defaultAltText String
  caption        String?
  uploaderId     String?
  uploader       AdminUser?          @relation("MediaUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([sha256Hash])
  @@index([provider, storageKey])
  @@index([uploaderId])
  @@map("media_assets")
}
