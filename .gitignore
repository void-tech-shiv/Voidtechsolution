# ==============================================================================
# VOIDTECH SOLUTION — Repository Hygiene & Ignore Specification
# Milestone: Cloudflare Migration Discovery & Repository Hygiene Audit
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Next.js, OpenNext & Production Build Outputs
# ------------------------------------------------------------------------------
/.next/
/out/
/build/
/dist/
/.open-next/
/.vercel/

# ------------------------------------------------------------------------------
# 2. Cloudflare Workers, Pages & Wrangler Artifacts
# ------------------------------------------------------------------------------
.wrangler/
.cloudflare/

# ------------------------------------------------------------------------------
# 3. Dependencies & Package Manager Artifacts
# ------------------------------------------------------------------------------
/node_modules/
/.pnp/
.pnp.js
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 4. Environment Variables, Local Configuration & Secrets
# ------------------------------------------------------------------------------
# Exclude all actual environment variable files and secret configurations
.env
.env.*
.dev.vars
.dev.vars.*

# CRITICAL PRESERVATION: Safely track template and example environment files
!.env.example
!.env.*.example
!.dev.vars.example

# Local credentials, private keys, and cryptographic certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 5. Testing, Coverage & Playwright Test Run Artifacts
# ------------------------------------------------------------------------------
/coverage/
/playwright-report/
/test-results/
.nyc_output/

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini

# Linux
*~

# ------------------------------------------------------------------------------
# 7. IDE, Editor & Developer Tool Artifacts
# ------------------------------------------------------------------------------
# JetBrains
.idea/
*.iws
*.iml

# Visual Studio & Windows Development
*.suo
*.ntvs*
*.njsproj
*.sln
*.user
*.userosscache
*.sln.docstates

# Vim / Emacs swap and backup files
*.sw?
*.swo
*.swp
*.bak
*.tmp

# Visual Studio Code workspace state (preserving team-shared settings & extensions)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# ------------------------------------------------------------------------------
# 8. Package Manager & Application Debug Logs
# ------------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
debug.log*

# ------------------------------------------------------------------------------
# 9. TypeScript & Next.js Type Caches
# ------------------------------------------------------------------------------
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 10. Database Local Scratch Files & Backups
# NOTE: Do NOT ignore all .sql files globally; Prisma migrations are version-controlled.
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sql.bak
*.sql.dump
*.sql.tar
*.sql.gz
*.dump
*.backup
