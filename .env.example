# ==============================================================================
# VOIDTECH SOLUTION — Environment Configuration Contract (.env.example)
# Tagline: Build. Launch. Grow Online.
# ==============================================================================
# Copy this file to .env (or .env.local) for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit real credentials, passwords, or production secrets to Git.
# 2. Only variables prefixed with NEXT_PUBLIC_ are exposed to client browser code.
# 3. All server-side secrets (DB passwords, SMTP keys, Auth secrets) must remain confidential.
# 4. In production, placeholder strings and localhost URLs will fail validation.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma ORM)
# ------------------------------------------------------------------------------
# Pooled connection string (used by Prisma Client runtime with connection pooling)
# Providers: Neon, Supabase, AWS RDS, PgBouncer
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/voidtech_db?schema=public"

# Direct connection string (used by Prisma CLI for migrations and introspection)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DIRECT_URL="postgresql://user:password@localhost:5432/voidtech_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Admin Portal & OTP Engine)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and cookies (minimum 32 characters)
# Generate a fresh 256-bit key via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-secure-random-32-byte-hex-string-minimum-32-chars"

# Secret pepper used for HMAC-SHA256 hashing of single-use 6-digit OTP codes
# Generate a fresh 256-bit key via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER_SECRET="replace-with-a-secure-random-32-byte-hex-pepper-secret"

# ------------------------------------------------------------------------------
# 3. ADMINISTRATOR BOOTSTRAP (Initial Account Seed)
# ------------------------------------------------------------------------------
# Primary system administrator email address
ADMIN_EMAIL="admin@voidtechsolution.com"

# Initial administrator bootstrap password (hashed with scrypt before storage; rotate upon first login)
ADMIN_PASSWORD="replace-with-a-strong-temporary-admin-password"

# ------------------------------------------------------------------------------
# 4. SMTP TRANSACTIONAL EMAIL (Nodemailer Subsystem)
# ------------------------------------------------------------------------------
# Standard SMTP outgoing server hostname (e.g. smtp.gmail.com, smtp.mailgun.org, smtp.sendgrid.net)
SMTP_HOST="smtp.voidtechsolution.com"

# SMTP port (587 for STARTTLS / TLS submission, 465 for SSL direct)
SMTP_PORT="587"

# Use SSL/TLS directly (true for port 465, false for port 587 / STARTTLS)
SMTP_SECURE="false"

# SMTP authenticated user or account email address
SMTP_USER="notifications@voidtechsolution.com"

# SMTP authenticated password or Gmail App Password (never use your primary Google account password)
SMTP_PASS="replace-with-your-smtp-password-or-app-password"

# Outbound sender display name
SMTP_FROM_NAME="VOIDTECH SOLUTION"

# Outbound verified sender email address
SMTP_FROM_EMAIL="notifications@voidtechsolution.com"

# Target inbox for inbound commercial leads and administrator security alerts
ADMIN_ALERT_EMAIL="admin@voidtechsolution.com"

# ------------------------------------------------------------------------------
# 5. APPLICATION RUNTIME & PUBLIC METADATA
# ------------------------------------------------------------------------------
# Canonical URL of the application (used for OpenGraph and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Application environment (development | test | production)
NODE_ENV="development"
