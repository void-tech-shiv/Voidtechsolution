# ==============================================================================
# VOIDTECH SOLUTION — Environment Configuration Contract
# ==============================================================================
# Copy this file to .env.local for local development.
# IMPORTANT:
# - NEVER commit real credentials, passwords, or production secrets to Git.
# - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# - All server-only credentials must remain confidential.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Connection string with connection pooling (e.g. Supabase, Neon, AWS RDS, PgBouncer)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true
DATABASE_URL="postgresql://user:password@localhost:5432/voidtech_db?schema=public"

# Direct connection to the database (used for migrations and schema introspection)
DIRECT_URL="postgresql://user:password@localhost:5432/voidtech_db?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Admin Portal)
# ------------------------------------------------------------------------------
# Secret key used for signing session tokens and cookies (minimum 32 characters)
# Generate using: openssl rand -base64 32
AUTH_SECRET="your-super-secret-random-hex-string-at-least-32-chars-long"

# Default seed administrator credentials (used for initial bootstrapping only)
ADMIN_EMAIL="admin@voidtechsolution.com"
ADMIN_PASSWORD="replace-with-a-secure-random-bootstrap-password"

# ------------------------------------------------------------------------------
# 3. EMAIL & NOTIFICATION DISPATCH (Enquiry System)
# ------------------------------------------------------------------------------
# API Key for transactional email provider (Resend, SendGrid, or AWS SES)
EMAIL_PROVIDER_API_KEY="re_sample_apiKey_or_sg_sample_apiKey"

# Sender address configured and verified in your email provider
EMAIL_FROM="notifications@voidtechsolution.com"

# Destination inbox for inbound customer enquiries
ENQUIRY_NOTIFICATION_RECIPIENT="contact@voidtechsolution.com"

# ------------------------------------------------------------------------------
# 4. APPLICATION RUNTIME & PUBLIC METADATA
# ------------------------------------------------------------------------------
# Canonical URL of the application (used for OpenGraph and metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Application environment (development | preview | production)
NODE_ENV="development"

